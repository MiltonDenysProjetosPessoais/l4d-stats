# Vercel KV (Redis) - obrigatório para armazenamento de dados
# Nota: @vercel/kv foi descontinuado. Para novos projetos, use a integração
# do Upstash Redis disponível no Vercel Marketplace:
# https://vercel.com/marketplace?category=storage&search=redis
# Para stores existentes do Vercel KV, elas foram migradas para Upstash Redis
# sob Vercel Integrations. As variáveis de ambiente abaixo são as mesmas.
# Obtenha essas variáveis no painel do Vercel em: Integrations > Upstash > .env.local
KV_REST_API_URL=your_kv_rest_api_url_here
KV_REST_API_TOKEN=your_kv_rest_api_token_here
KV_REST_API_READ_ONLY_TOKEN=your_kv_rest_api_read_only_token_here

# Token de administrador para a rota /api/admin-reset
# Gere um token seguro aleatório, ex: openssl rand -hex 32
ADMIN_TOKEN=your_secure_admin_token_here
